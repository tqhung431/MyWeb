# Copy this file to .env and change the values if needed. Never commit .env.
DATABASE_URL=postgres://myweb:myweb@localhost:5432/myweb
PORT=4000

# 127.0.0.1 = only this computer can reach the API. That's what we want:
# other PCs use the website (port 3000), which forwards /api/* to here.
HOST=127.0.0.1

# Optional: extra site addresses allowed to send POST/PUT/DELETE, comma-separated.
# Not needed for localhost or your network IP; the address you opened is always allowed.
ALLOWED_ORIGINS=

# Stage 5: Valkey (cache, rate limits, job queue). Nook still works if it's down.
VALKEY_URL=redis://127.0.0.1:6379

# Stage 5: email for the worker. Leave empty to print emails in the worker's terminal,
# or use Mailpit from docker-compose and read them at http://localhost:8025
SMTP_URL=
# SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Nook <hello@myweb.local>

# Stage 9: the Free-time Companion (local AI with Ollama, https://ollama.com).
# Install Ollama, then: ollama pull qwen2.5:1.5b && ollama pull paraphrase-multilingual
# Leave OLLAMA_URL empty to switch the AI off (the rest of Nook works the same).
OLLAMA_URL=
# OLLAMA_URL=http://127.0.0.1:11434
# AI_CHAT_MODEL=qwen2.5:1.5b
# AI_EMBED_MODEL=paraphrase-multilingual
