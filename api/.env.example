# For developers only (npm run dev / npm run worker). Docker doesn't use this file.
# Copy it to api/.env and change the values if needed. Never commit .env.

# The database from `docker compose up -d db`. The password must be the POSTGRES_PASSWORD in the
# main .env (next to docker-compose.yml); "nook" if you didn't change it.
DATABASE_URL=postgres://nook:nook@localhost:5432/nook
PORT=4000

# 127.0.0.1 = only this computer can reach the API. That's what we want:
# other PCs use the website (port 3000), which forwards /api/* to here.
HOST=127.0.0.1

# Optional: extra site addresses allowed to send POST/PUT/DELETE, comma-separated.
# Not needed for localhost or your network IP; the address you opened is always allowed.
ALLOWED_ORIGINS=

# Stage 5: Valkey (cache, rate limits, job queue). Nook still works if it's down.
VALKEY_URL=redis://127.0.0.1:6379

# Stage 5: email for the worker. Leave empty to print emails in the worker's terminal,
# or use Mailpit from docker-compose and read them at http://localhost:8025
SMTP_URL=
# SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Nook <hello@nook.local>

# Stage 9: the Free-time Companion (local AI with Ollama, https://ollama.com).
# Get Ollama running, either way:
#   - in Docker:  docker compose up -d ollama-models   (starts Ollama and downloads both models)
#   - or install it from ollama.com, then: ollama pull qwen2.5:1.5b && ollama pull paraphrase-multilingual
# then remove the # on the second OLLAMA_URL line below. Empty = AI off (the rest of Nook works the same).
OLLAMA_URL=
# OLLAMA_URL=http://127.0.0.1:11434
# AI_CHAT_MODEL=qwen2.5:1.5b
# AI_EMBED_MODEL=paraphrase-multilingual
