# Copy this file to .env and change the values if needed. Never commit .env.
DATABASE_URL=postgres://myweb:myweb@localhost:5432/myweb
PORT=4000

# The address you open in the browser (the Next.js site). Used for CSRF checks
# and to build the GitHub callback URL.
PUBLIC_URL=http://localhost:3000

# Optional: "Continue with GitHub". Create an OAuth app at
# https://github.com/settings/developers (see docs/stage-4.md), then paste:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
