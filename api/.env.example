# Copy this file to .env and change the values if needed. Never commit .env.
DATABASE_URL=postgres://myweb:myweb@localhost:5432/myweb
PORT=4000

# 127.0.0.1 = only this computer can reach the API. That's what we want:
# other PCs use the website (port 3000), which forwards /api/* to here.
HOST=127.0.0.1

# Optional: extra site addresses allowed to send POST/PUT/DELETE, comma-separated.
# Not needed for localhost or your network IP; the address you opened is always allowed.
ALLOWED_ORIGINS=
