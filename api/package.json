{
  "name": "nook-api",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --import ./dist/telemetry.js dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "worker": "tsx watch src/worker.ts",
    "start:worker": "node --import ./dist/telemetry.js dist/worker.js",
    "music:import": "tsx src/music/import.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^6.7.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "^5.11.1",
    "multer": "^2.5.0",
    "music-metadata": "^12.4.0",
    "pg": "8.23.1",
    "socket.io": "^4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "^4.8.4",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
