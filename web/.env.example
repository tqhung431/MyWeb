# For developers only (npm run dev). Docker doesn't use this file.
# Copy to web/.env.local if your API runs somewhere else than 127.0.0.1:4000.
# Used by the Next.js server: for Server Components, and to forward the browser's /api/* calls.
# The address is fixed at build time (npm run build), so rebuild after changing it.
API_URL=http://127.0.0.1:4000
