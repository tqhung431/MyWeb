# Settings for docker compose. Copy to ".env" (git ignores it) and change what you need.

# Database password. Change it before letting others use MyWeb.
POSTGRES_PASSWORD=myweb

# Ports Caddy uses on this PC. If something else already uses 80 (e.g. Skype or IIS on Windows),
# set HTTP_PORT=8080 and open http://<this PC's IP>:8080 instead.
HTTP_PORT=80
HTTPS_PORT=443

# Email: by default emails go to Mailpit (http://localhost:8025). Use a real SMTP server to send them.
# SMTP_URL=smtps://user:password@smtp.example.com:465

# Stage 8, monitoring: start with  docker compose --profile app --profile monitoring up -d
# then uncomment these three lines and open Grafana at http://localhost:3001
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
# CADDY_TRACING=tracing_on
# CADDY_OTLP_ENDPOINT=http://otel-lgtm:4317

# Stage 9, the Free-time Companion (local AI): start with
#   docker compose --profile app --profile ai up -d
# The first start downloads the models (~1.5 GB). Smaller PC? Try AI_CHAT_MODEL=qwen2.5:0.5b.
# Changing AI_EMBED_MODEL to one with a different size of embedding also needs a new migration.
# OLLAMA_URL=           (empty: switch the AI off completely)
# AI_CHAT_MODEL=qwen2.5:1.5b
# AI_EMBED_MODEL=paraphrase-multilingual
