# Caddy: Nook's front door (Stage 7). Every visitor's request arrives here first.
#
#   /api/*  (data, sign-in, live events) → the API, WebSockets included
#   everything else (pages)             → the website
#
# Caddy also:
#   - gives https://localhost a real HTTPS certificate from its own local certificate authority
#   - tells the API the visitor's real IP (X-Forwarded-For) and whether they used HTTPS
#     (X-Forwarded-Proto), ignoring any such headers the browser tries to send itself
#   - compresses responses
#
# API_UPSTREAM / WEB_UPSTREAM default to the Docker service names; you can point them elsewhere
# to try Caddy without Docker, e.g. API_UPSTREAM=127.0.0.1:4000 WEB_UPSTREAM=127.0.0.1:3000 caddy run

# Stage 20: the Cloudflare tunnel's entrance (:8080, below) is reached only by the cloudflared container,
# which passes on the visitor's real IP and "https" in X-Forwarded-For / -Proto. Trust those headers there only.
{
	servers :8080 {
		trusted_proxies static private_ranges
	}
	# Your own reverse proxy (nginx on a cloud server, docs/deploy-gcp.md) comes in on :8081 and passes on the
	# visitor's real IP and "https". :8081 is published on 127.0.0.1 only, so only programs on the server reach it.
	servers :8081 {
		trusted_proxies static private_ranges
	}
}

# Stage 8: tracing. With monitoring on (CADDY_TRACING=tracing_on), Caddy starts each request's
# trace and passes it on ("traceparent"), so Grafana shows Caddy → website → API → database.
(tracing_on) {
	tracing {
		span caddy
	}
}

(tracing_off) {
}

(nook) {
	import {$CADDY_TRACING:tracing_off}
	encode zstd gzip

	# Song uploads can be large (Stage 8); Caddy itself sets no limit, the API checks the size.

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:4000}
	}
	handle {
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Stage 20: no other site may show Nook inside a frame (stops "clickjacking"),
		# and Nook never asks for the camera, microphone, location or payments
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
}

# On the PC running Nook: https://localhost (http://localhost redirects here)
localhost {
	tls internal
	import nook
}

# Other PCs and phones on your network: http://<this PC's IP>, e.g. http://192.168.1.20
:80 {
	import nook
}

# Stage 20: Nook on a public web address, through a Cloudflare tunnel (profile "tunnel").
# This port is NOT published to your PC or network: only the cloudflared container can reach it.
# Before anything else, Caddy asks the API whether the request carries a valid Cloudflare Access pass
# (GET /internal/access-check). No valid pass → a short "Nook is private" page. Nothing gets through
# if Access isn't set up ("fail closed"). See docs/stage-20.md.
:8080 {
	forward_auth {$API_UPSTREAM:api:4000} {
		uri /internal/access-check
	}
	header Strict-Transport-Security "max-age=31536000"
	import nook
}

# Stage 20: Nook behind your own reverse proxy (nginx with HTTPS and a password, e.g. on a Google Cloud server).
# Published on 127.0.0.1:${PROXY_PORT} only (docker-compose.yml): nginx on the same machine connects here.
# The proxy must check who you are (Nook has no passwords): see deploy/nginx/nook.conf and docs/deploy-gcp.md.
:8081 {
	header Strict-Transport-Security "max-age=31536000"
	import nook
}
